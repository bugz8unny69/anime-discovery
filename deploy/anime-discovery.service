[Unit]
Description=Anime Discovery homelab web, webhook and acquisition daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anime-discovery
Group=anime-discovery
WorkingDirectory=/opt/anime-discovery
ExecStart=/usr/bin/python3 /opt/anime-discovery/src/legacy/anime-discovery-live.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
