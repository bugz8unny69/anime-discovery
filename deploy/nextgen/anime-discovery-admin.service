[Unit]
Description=Anime Discovery local administration API
Requires=anime-discovery-admin.socket
After=anime-discovery-admin.socket
PartOf=anime-discovery.target

[Service]
Type=simple
User=anime-discovery
Group=anime-discovery
WorkingDirectory=/opt/anime-discovery
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/anime-discovery/.venv/bin/python -m src.nextgen.api serve --socket-activated --config-dir /var/lib/anime-discovery/config
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/anime-discovery
StandardOutput=journal
StandardError=journal
