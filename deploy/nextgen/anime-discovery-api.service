[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
Description=Anime Discovery management API
PartOf=anime-discovery.target
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60s
User=anime-discovery
Group=anime-discovery
WorkingDirectory=/opt/anime-discovery
Environment=PYTHONUNBUFFERED=1
Environment=ANIME_DISCOVERY_ADMIN_SOCKET=/run/anime-discovery/admin.sock
RuntimeDirectory=anime-discovery
RuntimeDirectoryMode=0700
# Replace the origin with the exact HTTPS dashboard origin before installing.
ExecStart=/opt/anime-discovery/.venv/bin/python -m src.nextgen.api serve --config-dir /etc/anime-discovery --public-origin https://anime.example.invalid
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/anime-discovery /etc/anime-discovery
StandardOutput=journal
StandardError=journal
